<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- เมนูปุ่มควบคุมหลัก -->
    <LinearLayout
        android:id="@+id/mainMenuContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="4dp">

        <!-- ปุ่มหลัก: ไอคอนหุ่นยนต์ (ลากย้ายได้ / แตะเพื่อซ่อน-แสดงเมนู) -->
        <ImageButton
            android:id="@+id/btnMain"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="Robot Icon"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_robot_logo" />

        <LinearLayout
            android:id="@+id/controlButtonsGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- ปุ่ม 3 (Zoom) -->
            <ImageButton
                android:id="@+id/btn3"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginBottom="3dp"
                android:background="@drawable/circle_button_bg"
                app:backgroundTint="@null"
                android:contentDescription="Zoom Join"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_zoom"
                app:tint="#000000" />

            <!-- ปุ่ม 4 (กล้องสตรีมจาก Pi 5) -->
            <Button
                android:id="@+id/btn4"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginBottom="3dp"
                android:background="@drawable/circle_button_bg"
                app:backgroundTint="@null"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="📷"
                android:textColor="#000000"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- กรอบแสดงผลสตรีมกล้องจาก Pi 5 (ปุ่ม 4) -->
    <FrameLayout
        android:id="@+id/streamContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <WebView
            android:id="@+id/streamWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none" />

        <!-- แสดงผลจำนวนนิ้วมือมุมซ้ายบน (รับค่าจาก WebSocket ของ Pi 5) -->
        <TextView
            android:id="@+id/tvFingerCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:background="@null"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- ปุ่มปิดสตรีม -->
        <Button
            android:id="@+id/btnCloseStream"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/circle_button_bg"
            app:backgroundTint="#F44336"
            android:elevation="100dp"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </FrameLayout>

</FrameLayout>
