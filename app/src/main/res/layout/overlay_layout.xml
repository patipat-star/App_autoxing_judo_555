<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- เมนูปุ่มควบคุมหลัก -->
    <LinearLayout
        android:id="@+id/mainMenuContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="4dp">

        <!-- ปุ่มหลัก: ไอคอนหุ่นยนต์ (ลากย้ายได้ / แตะเพื่อซ่อน-แสดงเมนู) -->
        <ImageButton
            android:id="@+id/btnMain"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/desc_robot_icon"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_robot_logo" />

        <LinearLayout
            android:id="@+id/controlButtonsGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- ปุ่ม 1 (Zoom) -->
            <ImageButton
                android:id="@+id/btn1"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginBottom="3dp"
                android:background="@drawable/circle_button_bg"
                android:contentDescription="@string/desc_zoom_join"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_zoom" />

            <!-- ปุ่ม 2 (กล้องสตรีมจาก Pi 5) -->
            <Button
                android:id="@+id/btn2"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginBottom="3dp"
                android:background="@drawable/circle_button_bg"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/label_camera_button"
                android:textColor="#000000"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- กรอบแสดงผลสตรีมกล้องจาก Pi 5 (ปุ่ม 2) -->
    <FrameLayout
        android:id="@+id/streamContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <WebView
            android:id="@+id/streamWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none" />

        <!-- แสดงผลจำนวนนิ้วมือมุมซ้ายบน (รับค่าจาก WebSocket ของ Pi 5) -->
        <TextView
            android:id="@+id/tvFingerCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:padding="12dp"
            android:background="@null"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text="@string/finger_count_default"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- ปุ่มปิดสตรีม -->
        <Button
            android:id="@+id/btnCloseStream"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/circle_close_bg"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="@string/label_close_symbol"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- แผงตั้งค่า IP ของ Pi 5 (ซ่อนอยู่ เปิดได้โดยกดค้างที่ตัวเลขจำนวนนิ้วมือ) -->
        <LinearLayout
            android:id="@+id/settingsPanel"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#E6212121"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <!-- ขั้นที่ 1: ถาม PIN (แสดงเมื่อเคยตั้ง PIN ไว้แล้ว) -->
            <LinearLayout
                android:id="@+id/pinSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_pin_title"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etPin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/settings_pin_hint"
                    android:importantForAutofill="no"
                    android:inputType="numberPassword"
                    android:maxLength="8"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPinCancel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_cancel" />

                    <Button
                        android:id="@+id/btnPinOk"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_ok" />
                </LinearLayout>
            </LinearLayout>

            <!-- ขั้นที่ 2: ตั้งค่า IP (แสดงหลังใส่ PIN ถูก หรือครั้งแรกที่ยังไม่มี PIN) -->
            <LinearLayout
                android:id="@+id/hostSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_host_title"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etPiHost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/settings_host_hint"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888" />

                <EditText
                    android:id="@+id/etNewPin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="@string/settings_new_pin_hint"
                    android:importantForAutofill="no"
                    android:inputType="numberPassword"
                    android:maxLength="8"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnResetHost"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_reset" />

                    <Button
                        android:id="@+id/btnCancelHost"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_cancel" />

                    <Button
                        android:id="@+id/btnSaveHost"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_save" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>

</FrameLayout>
